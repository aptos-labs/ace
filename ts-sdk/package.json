{
  "name": "@aptos-labs/ace-sdk",
  "version": "0.1.1",
  "description": "TypeScript SDK for ACE",
  "main": "dist/esm/index.mjs",
  "module": "dist/esm/index.mjs",
  "types": "dist/esm/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.mts",
      "import": "./dist/esm/index.mjs",
      "default": "./dist/esm/index.mjs"
    },
    "./aptos": {
      "types": "./dist/esm/aptos.d.mts",
      "import": "./dist/esm/aptos.mjs",
      "default": "./dist/esm/aptos.mjs"
    },
    "./solana": {
      "types": "./dist/esm/solana.d.mts",
      "import": "./dist/esm/solana.mjs",
      "default": "./dist/esm/solana.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:clean": "rm -rf dist",
    "build": "npm run build:clean && tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ace",
    "encryption",
    "access-control",
    "cryptography",
    "sdk"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@hpke/chacha20poly1305": "^1.7.0",
    "@hpke/core": "^1.7.0",
    "@noble/ciphers": "^1.2.1",
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^1.7.1"
  },
  "peerDependencies": {
    "@aptos-labs/ts-sdk": "^7",
    "@solana/web3.js": "^1.95.0"
  },
  "peerDependenciesMeta": {
    "@solana/web3.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aptos-labs/ts-sdk": "^7",
    "@solana/web3.js": "^1.95.0",
    "@types/node": "^22.0.0",
    "postcss": "8.5.26",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=22"
  }
}
