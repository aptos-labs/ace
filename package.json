{
  "name": "ace",
  "version": "0.0.0",
  "private": true,
  "description": "ACE monorepo",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean",
    "ace-node-onboarding": "pnpm --filter @aptos-labs/ace-node-onboarding exec tsx src/index.ts"
  },
  "keywords": [
    "ace",
    "encryption",
    "access-control",
    "cryptography"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "nanoid": "3.3.18",
      "picomatch": "4.0.5",
      "postcss": "8.5.26",
      "rollup": "4.62.4",
      "undici": "6.28.0"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2016-10538"
      ]
    }
  }
}
