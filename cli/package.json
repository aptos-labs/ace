{
  "name": "@aptos-labs/ace-cli",
  "version": "0.1.0",
  "description": "ACE network operator CLI",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "ace": "./dist/index.js"
  },
  "files": [
    "dist",
    "move"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "pnpm --filter @aptos-labs/ace-sdk build && tsc --noEmit",
    "test": "tsx --test src/aptos-network.test.ts src/gas-station.test.ts",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aptos-labs/ace-sdk": "workspace:*",
    "@aptos-labs/gas-station-client": "^2.0.3",
    "@aptos-labs/ts-sdk": "^7",
    "@inquirer/core": "^11.1.9",
    "@inquirer/prompts": "^7.0.0",
    "commander": "^12.1.0",
    "smol-toml": "^1.6.1",
    "undici": "6.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "postcss": "8.5.26",
    "tsup": "^8.5.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.3"
  }
}
